// Pyloom POS — Prisma Schema
// Powered by Pyloom Technologies
// PostgreSQL 12.4 Compatible

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ============================================================
// ENUMS
// ============================================================

enum UserStatus {
  active
  inactive
  locked
}

enum InvoiceStatus {
  draft
  confirmed
  cancelled
  returned
}

enum PaymentMethod {
  cash
  bank_transfer
  card
  digital_wallet
  qr
  customer_credit
  split
}

enum PaymentStatus {
  pending
  completed
  failed
  refunded
}

enum StockMovementType {
  purchase
  sale
  return_in
  return_out
  adjustment
  transfer
  opening
}

enum JournalStatus {
  draft
  posted
  cancelled
}

enum AccountType {
  asset
  liability
  equity
  revenue
  expense
}

enum TaxType {
  taxable_exclusive
  taxable_inclusive
  non_taxable
  zero_rated
  exempt
}

enum ReturnDisposition {
  resaleable
  damaged
  expired
  write_off
}

// ============================================================
// AUTHENTICATION & ROLES
// ============================================================

model Role {
  id          Int      @id @default(autoincrement())
  name        String   @unique @db.VarChar(100)
  description String?
  isSystem    Boolean  @default(false) @map("is_system")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  users           User[]
  rolePermissions RolePermission[]

  @@map("roles")
}

model Permission {
  id          Int    @id @default(autoincrement())
  module      String @db.VarChar(100)
  action      String @db.VarChar(100)
  description String?

  rolePermissions RolePermission[]

  @@unique([module, action])
  @@map("permissions")
}

model RolePermission {
  roleId       Int @map("role_id")
  permissionId Int @map("permission_id")

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

model User {
  id            Int        @id @default(autoincrement())
  username      String     @unique @db.VarChar(100)
  email         String?    @unique @db.VarChar(255)
  passwordHash  String     @map("password_hash") @db.VarChar(255)
  fullName      String     @map("full_name") @db.VarChar(255)
  roleId        Int        @map("role_id")
  status        UserStatus @default(active)
  lastLogin     DateTime?  @map("last_login")
  loginAttempts Int        @default(0) @map("login_attempts")
  lockedUntil   DateTime?  @map("locked_until")
  createdBy     Int?       @map("created_by")
  createdAt     DateTime   @default(now()) @map("created_at")
  updatedAt     DateTime   @updatedAt @map("updated_at")

  role          Role @relation(fields: [roleId], references: [id])
  createdByUser User? @relation("UserCreatedBy", fields: [createdBy], references: [id])
  createdUsers  User[] @relation("UserCreatedBy")

  auditLogs         AuditLog[]
  salesInvoices     SalesInvoice[]     @relation("Cashier")
  cashDrawerSessions CashDrawerSession[]
  journalEntries    JournalEntry[]     @relation("CreatedBy")
  postedJournals    JournalEntry[]     @relation("PostedBy")
  stockAdjustments  StockAdjustment[]  @relation("CreatedBy")
  approvedAdj       StockAdjustment[]  @relation("ApprovedBy")
  itemPriceHistory  ItemPriceHistory[]
  purchaseInvoices  PurchaseInvoice[]

  @@map("users")
}

model AuditLog {
  id        BigInt   @id @default(autoincrement())
  userId    Int?     @map("user_id")
  username  String?  @db.VarChar(100)
  action    String   @db.VarChar(255)
  entity    String   @db.VarChar(100)
  entityId  String?  @map("entity_id") @db.VarChar(100)
  oldValues Json?    @map("old_values")
  newValues Json?    @map("new_values")
  ipAddress String?  @map("ip_address")
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id])

  @@index([entity, entityId])
  @@index([userId])
  @@index([createdAt])
  @@map("audit_logs")
}

// ============================================================
// COMPANY & SETTINGS
// ============================================================

model CompanySettings {
  id             Int      @id @default(autoincrement())
  companyName    String   @map("company_name") @db.VarChar(255)
  companyLogo    String?  @map("company_logo") @db.VarChar(500)
  addressLine1   String?  @map("address_line1") @db.VarChar(500)
  addressLine2   String?  @map("address_line2") @db.VarChar(500)
  city           String?  @db.VarChar(100)
  phone          String?  @db.VarChar(50)
  email          String?  @db.VarChar(255)
  website        String?  @db.VarChar(255)
  panVatNumber   String?  @map("pan_vat_number") @db.VarChar(50)
  currencyCode   String   @default("NPR") @map("currency_code") @db.VarChar(10)
  timezone       String   @default("Asia/Kathmandu") @db.VarChar(100)
  fiscalYearStart String  @default("07-16") @map("fiscal_year_start") @db.VarChar(10)
  invoiceFooter  String?  @map("invoice_footer")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@map("company_settings")
}

model AppSetting {
  key       String   @id @db.VarChar(255)
  value     String?
  label     String?  @db.VarChar(255)
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("app_settings")
}

model NumberingSeries {
  id          Int     @id @default(autoincrement())
  seriesCode  String  @unique @map("series_code") @db.VarChar(20)
  prefix      String  @db.VarChar(20)
  lastNumber  BigInt  @default(0) @map("last_number")
  padding     Int     @default(6)
  resetYearly Boolean @default(true) @map("reset_yearly")
  currentYear String? @map("current_year") @db.VarChar(10)

  @@map("numbering_series")
}

// ============================================================
// TAX RATES
// ============================================================

model TaxRate {
  id        Int     @id @default(autoincrement())
  name      String  @db.VarChar(100)
  rate      Decimal @db.Decimal(8, 4)
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  items SalesInvoiceItem[]
  purchaseItems PurchaseInvoiceItem[]

  @@map("tax_rates")
}

// ============================================================
// PARTIES
// ============================================================

model Customer {
  id              Int      @id @default(autoincrement())
  customerCode    String?  @unique @map("customer_code") @db.VarChar(50)
  name            String   @db.VarChar(255)
  phone           String?  @db.VarChar(20)
  phoneNormalized String?  @unique @map("phone_normalized") @db.VarChar(20)
  alternatePhone  String?  @map("alternate_phone") @db.VarChar(20)
  email           String?  @db.VarChar(255)
  address         String?
  panVatNumber    String?  @map("pan_vat_number") @db.VarChar(50)
  idCardType      String?  @map("id_card_type") @db.VarChar(50)
  idCardNumber    String?  @map("id_card_number") @db.VarChar(100)
  idCardImageUrl  String?  @map("id_card_image_url") @db.VarChar(500)
  openingBalance  Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  creditLimit     Decimal  @default(0) @map("credit_limit") @db.Decimal(15, 2)
  isWalkin        Boolean  @default(false) @map("is_walkin")
  isActive        Boolean  @default(true) @map("is_active")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  salesInvoices SalesInvoice[]
  salesReturns  SalesReturn[]
  creditNotes   CreditNote[]
  payments      Payment[]

  @@index([phoneNormalized])
  @@index([name])
  @@map("customers")
}

model Supplier {
  id             Int      @id @default(autoincrement())
  supplierCode   String?  @unique @map("supplier_code") @db.VarChar(50)
  name           String   @db.VarChar(255)
  contactPerson  String?  @map("contact_person") @db.VarChar(255)
  phone          String?  @db.VarChar(20)
  email          String?  @db.VarChar(255)
  address        String?
  panVatNumber   String?  @map("pan_vat_number") @db.VarChar(50)
  openingBalance Decimal  @default(0) @map("opening_balance") @db.Decimal(15, 2)
  paymentTermsDays Int    @default(0) @map("payment_terms_days")
  isActive       Boolean  @default(true) @map("is_active")
  createdBy      Int?     @map("created_by")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  purchaseOrders   PurchaseOrder[]
  goodsReceipts    GoodsReceipt[]
  purchaseInvoices PurchaseInvoice[]
  purchaseReturns  PurchaseReturn[]
  payments         Payment[]

  @@index([name])
  @@map("suppliers")
}

// ============================================================
// ITEM CATALOG
// ============================================================

model Category {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(255)
  parentId  Int?     @map("parent_id")
  isActive  Boolean  @default(true) @map("is_active")
  createdAt DateTime @default(now()) @map("created_at")

  parent   Category?  @relation("CategoryParent", fields: [parentId], references: [id])
  children Category[] @relation("CategoryParent")
  items    Item[]

  @@map("categories")
}

model Brand {
  id       Int     @id @default(autoincrement())
  name     String  @unique @db.VarChar(255)
  isActive Boolean @default(true) @map("is_active")

  items Item[]

  @@map("brands")
}

model Unit {
  id           Int     @id @default(autoincrement())
  name         String  @unique @db.VarChar(100)
  abbreviation String? @db.VarChar(20)
  isActive     Boolean @default(true) @map("is_active")

  items         Item[]
  conversions   ItemUnitConversion[]
  priceListItems PriceListItem[]
  salesLines    SalesInvoiceItem[]
  purchaseLines PurchaseInvoiceItem[]

  @@map("units")
}

model Item {
  id            Int      @id @default(autoincrement())
  itemCode      String   @unique @map("item_code") @db.VarChar(100)
  barcode       String?  @unique @db.VarChar(100)
  name          String   @db.VarChar(500)
  description   String?
  categoryId    Int?     @map("category_id")
  brandId       Int?     @map("brand_id")
  unitId        Int      @map("unit_id")
  taxRateId     Int?     @map("tax_rate_id")
  taxType       TaxType  @default(taxable_exclusive) @map("tax_type")
  isStockItem    Boolean  @default(true) @map("is_stock_item")
  purchasePrice  Decimal  @default(0) @map("purchase_price") @db.Decimal(15, 4)
  sellingPrice  Decimal  @default(0) @map("selling_price") @db.Decimal(15, 4)
  minimumStock  Decimal  @default(0) @map("minimum_stock") @db.Decimal(12, 4)
  reorderLevel  Decimal  @default(0) @map("reorder_level") @db.Decimal(12, 4)
  imageUrl      String?  @map("image_url") @db.VarChar(500)
  isActive      Boolean  @default(true) @map("is_active")
  createdBy     Int?     @map("created_by")
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  category           Category?          @relation(fields: [categoryId], references: [id])
  brand              Brand?             @relation(fields: [brandId], references: [id])
  unit               Unit               @relation(fields: [unitId], references: [id])
  barcodes           ItemBarcode[]
  unitConversions    ItemUnitConversion[]
  priceListPrices    PriceListItem[]
  priceHistory       ItemPriceHistory[]
  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]
  salesInvoiceItems  SalesInvoiceItem[]
  salesReturnItems   SalesReturnItem[]
  purchaseInvoiceItems PurchaseInvoiceItem[]
  purchaseReturnItems  PurchaseReturnItem[]
  adjustmentItems    StockAdjustmentItem[]

  @@index([barcode])
  @@index([itemCode])
  @@index([name])
  @@index([categoryId])
  @@map("items")
}

model ItemUnitConversion {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  unitId    Int      @map("unit_id")
  factor    Decimal  @db.Decimal(15, 6)
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit Unit @relation(fields: [unitId], references: [id])

  @@unique([itemId, unitId])
  @@map("item_unit_conversions")
}

model PriceList {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(255)
  description String?
  isDefault   Boolean  @default(false) @map("is_default")
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")
  updatedAt   DateTime @updatedAt @map("updated_at")

  items PriceListItem[]

  @@map("price_lists")
}

model PriceListItem {
  id          Int      @id @default(autoincrement())
  priceListId Int      @map("price_list_id")
  itemId      Int      @map("item_id")
  unitId      Int?     @map("unit_id")
  price       Decimal  @db.Decimal(15, 4)
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at")

  priceList PriceList @relation(fields: [priceListId], references: [id], onDelete: Cascade)
  item      Item      @relation(fields: [itemId], references: [id], onDelete: Cascade)
  unit      Unit?     @relation(fields: [unitId], references: [id])

  @@unique([priceListId, itemId])
  @@index([itemId])
  @@map("price_list_items")
}

model ItemBarcode {
  id        Int      @id @default(autoincrement())
  itemId    Int      @map("item_id")
  barcode   String   @unique @db.VarChar(100)
  isPrimary Boolean  @default(false) @map("is_primary")
  createdAt DateTime @default(now()) @map("created_at")

  item Item @relation(fields: [itemId], references: [id], onDelete: Cascade)

  @@index([barcode])
  @@map("item_barcodes")
}

model ItemPriceHistory {
  id          BigInt   @id @default(autoincrement())
  itemId      Int      @map("item_id")
  oldPurchase Decimal? @map("old_purchase") @db.Decimal(15, 4)
  newPurchase Decimal? @map("new_purchase") @db.Decimal(15, 4)
  oldSelling  Decimal? @map("old_selling") @db.Decimal(15, 4)
  newSelling  Decimal? @map("new_selling") @db.Decimal(15, 4)
  changedBy   Int?     @map("changed_by")
  reason      String?
  changedAt   DateTime @default(now()) @map("changed_at")

  item    Item  @relation(fields: [itemId], references: [id])
  user    User? @relation(fields: [changedBy], references: [id])

  @@map("item_price_history")
}

// ============================================================
// INVENTORY
// ============================================================

model Warehouse {
  id        Int     @id @default(autoincrement())
  code      String  @unique @db.VarChar(50)
  name      String  @db.VarChar(255)
  address   String?
  isDefault Boolean @default(false) @map("is_default")
  isActive  Boolean @default(true) @map("is_active")

  stockBalances      StockBalance[]
  inventoryMovements InventoryMovement[]
  goodsReceipts      GoodsReceipt[]
  stockAdjustments   StockAdjustment[]

  @@map("warehouses")
}

model StockBalance {
  id          BigInt  @id @default(autoincrement())
  itemId      Int     @map("item_id")
  warehouseId Int     @map("warehouse_id")
  quantity    Decimal @default(0) @db.Decimal(12, 4)
  averageCost Decimal @default(0) @map("average_cost") @db.Decimal(15, 4)

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@unique([itemId, warehouseId])
  @@index([itemId])
  @@map("stock_balances")
}

model InventoryMovement {
  id            BigInt            @id @default(autoincrement())
  itemId        Int               @map("item_id")
  warehouseId   Int               @map("warehouse_id")
  movementType  StockMovementType @map("movement_type")
  quantity      Decimal           @db.Decimal(12, 4)
  unitCost      Decimal?          @map("unit_cost") @db.Decimal(15, 4)
  referenceType String?           @map("reference_type") @db.VarChar(50)
  referenceId   BigInt?           @map("reference_id")
  narration     String?
  createdBy     Int?              @map("created_by")
  createdAt     DateTime          @default(now()) @map("created_at")

  item      Item      @relation(fields: [itemId], references: [id])
  warehouse Warehouse @relation(fields: [warehouseId], references: [id])

  @@index([itemId])
  @@index([createdAt])
  @@index([referenceType, referenceId])
  @@map("inventory_movements")
}

model StockAdjustment {
  id              Int      @id @default(autoincrement())
  adjNumber       String   @unique @map("adj_number") @db.VarChar(50)
  warehouseId     Int      @map("warehouse_id")
  adjustmentDate  DateTime @map("adjustment_date") @db.Date
  reason          String?
  status          String   @default("pending") @db.VarChar(20)
  approvedBy      Int?     @map("approved_by")
  approvedAt      DateTime? @map("approved_at")
  createdBy       Int?     @map("created_by")
  createdAt       DateTime @default(now()) @map("created_at")

  warehouse      Warehouse            @relation(fields: [warehouseId], references: [id])
  approvedByUser User?                @relation("ApprovedBy", fields: [approvedBy], references: [id])
  createdByUser  User?                @relation("CreatedBy", fields: [createdBy], references: [id])
  items          StockAdjustmentItem[]

  @@map("stock_adjustments")
}

model StockAdjustmentItem {
  id             Int      @id @default(autoincrement())
  adjustmentId   Int      @map("adjustment_id")
  itemId         Int      @map("item_id")
  systemQuantity Decimal? @map("system_quantity") @db.Decimal(12, 4)
  actualQuantity Decimal? @map("actual_quantity") @db.Decimal(12, 4)
  difference     Decimal? @db.Decimal(12, 4)
  unitCost       Decimal? @map("unit_cost") @db.Decimal(15, 4)

  adjustment StockAdjustment @relation(fields: [adjustmentId], references: [id])
  item       Item             @relation(fields: [itemId], references: [id])

  @@map("stock_adjustment_items")
}

model ItemImportBatch {
  id          BigInt   @id @default(autoincrement())
  batchKey    String   @unique @map("batch_key") @db.VarChar(36)
  fileHash    String   @unique @map("file_hash") @db.VarChar(64)
  fileName    String   @map("file_name") @db.VarChar(255)
  status      String   @default("preview") @db.VarChar(20)
  mode        String?  @db.VarChar(30)
  updatePrices Boolean @default(true) @map("update_prices")
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")
  completedAt DateTime? @map("completed_at")

  rows ItemImportRow[]

  @@index([createdAt])
  @@map("item_import_batches")
}

model ItemImportRow {
  id          BigInt   @id @default(autoincrement())
  batchId     BigInt   @map("batch_id")
  rowNumber   Int      @map("row_number")
  payload     Json
  status      String   @default("pending") @db.VarChar(20)
  errors      Json?
  itemId      Int?     @map("item_id")
  transactionId BigInt? @map("transaction_id")
  result      Json?

  batch ItemImportBatch @relation(fields: [batchId], references: [id], onDelete: Cascade)

  @@unique([batchId, rowNumber])
  @@index([batchId, status])
  @@map("item_import_rows")
}

// ============================================================
// SALES
// ============================================================

model SalesInvoice {
  id                  BigInt        @id @default(autoincrement())
  invoiceNumber       String        @unique @map("invoice_number") @db.VarChar(50)
  invoiceDate         DateTime      @map("invoice_date") @db.Date
  customerId          Int           @map("customer_id")
  subtotal            Decimal       @db.Decimal(15, 2)
  discountAmount      Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxableAmount       Decimal       @default(0) @map("taxable_amount") @db.Decimal(15, 2)
  taxAmount           Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  nonTaxableAmount    Decimal       @default(0) @map("non_taxable_amount") @db.Decimal(15, 2)
  grandTotal          Decimal       @map("grand_total") @db.Decimal(15, 2)
  paidAmount          Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  outstandingAmount   Decimal       @default(0) @map("outstanding_amount") @db.Decimal(15, 2)
  status              InvoiceStatus @default(confirmed)
  isCredit            Boolean       @default(false) @map("is_credit")
  paymentMethod       PaymentMethod? @map("payment_method")
  dueDate             DateTime?     @map("due_date") @db.Date
  notes               String?
  cashierId           Int?          @map("cashier_id")
  cashDrawerSessionId BigInt?       @map("cash_drawer_session_id")
  idempotencyKey      String?       @unique @map("idempotency_key") @db.VarChar(100)
  createdAt           DateTime      @default(now()) @map("created_at")
  updatedAt           DateTime      @updatedAt @map("updated_at")

  customer        Customer           @relation(fields: [customerId], references: [id])
  cashier         User?              @relation("Cashier", fields: [cashierId], references: [id])
  cashDrawerSession CashDrawerSession? @relation(fields: [cashDrawerSessionId], references: [id])
  items           SalesInvoiceItem[]
  salesReturns    SalesReturn[]
  paymentAllocations PaymentAllocation[]

  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([customerId])
  @@index([status])
  @@map("sales_invoices")
}

model SalesInvoiceItem {
  id             BigInt   @id @default(autoincrement())
  invoiceId      BigInt   @map("invoice_id")
  itemId         Int      @map("item_id")
  unitId         Int?     @map("unit_id")
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(15, 6)
  quantity       Decimal  @db.Decimal(12, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(15, 4)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(8, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 4)
  taxType        TaxType? @map("tax_type")
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxRateId      Int?     @map("tax_rate_id")
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 4)
  lineTotal      Decimal  @map("line_total") @db.Decimal(15, 4)
  costAtSale     Decimal? @map("cost_at_sale") @db.Decimal(15, 4)
  returnedQty    Decimal  @default(0) @map("returned_qty") @db.Decimal(12, 4)

  invoice  SalesInvoice @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  item     Item         @relation(fields: [itemId], references: [id])
  unit     Unit?        @relation(fields: [unitId], references: [id])
  taxRateRef TaxRate?   @relation(fields: [taxRateId], references: [id])
  returnItems SalesReturnItem[]

  @@index([invoiceId])
  @@index([itemId])
  @@map("sales_invoice_items")
}

model SalesReturn {
  id                BigInt   @id @default(autoincrement())
  returnNumber      String   @unique @map("return_number") @db.VarChar(50)
  originalInvoiceId BigInt   @map("original_invoice_id")
  returnDate        DateTime @map("return_date") @db.Date
  customerId        Int      @map("customer_id")
  returnReason      String?  @map("return_reason")
  subtotal          Decimal  @default(0) @db.Decimal(15, 2)
  taxAmount         Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 2)
  totalAmount       Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  refundMethod      String?  @map("refund_method") @db.VarChar(50)
  refundAmount      Decimal  @default(0) @map("refund_amount") @db.Decimal(15, 2)
  status            String   @default("completed") @db.VarChar(20)
  processedBy       Int?     @map("processed_by")
  createdAt         DateTime @default(now()) @map("created_at")

  originalInvoice SalesInvoice     @relation(fields: [originalInvoiceId], references: [id])
  customer        Customer         @relation(fields: [customerId], references: [id])
  items           SalesReturnItem[]
  creditNotes     CreditNote[]

  @@map("sales_returns")
}

model SalesReturnItem {
  id               BigInt            @id @default(autoincrement())
  returnId         BigInt            @map("return_id")
  originalItemId   BigInt            @map("original_item_id")
  itemId           Int               @map("item_id")
  returnedQty      Decimal           @map("returned_qty") @db.Decimal(12, 4)
  unitPrice        Decimal           @map("unit_price") @db.Decimal(15, 4)
  taxAmount        Decimal           @default(0) @map("tax_amount") @db.Decimal(15, 4)
  lineTotal        Decimal           @map("line_total") @db.Decimal(15, 4)
  disposition      ReturnDisposition @default(resaleable)
  costAtSale       Decimal?          @map("cost_at_sale") @db.Decimal(15, 4)

  salesReturn  SalesReturn      @relation(fields: [returnId], references: [id])
  originalItem SalesInvoiceItem @relation(fields: [originalItemId], references: [id])
  item         Item             @relation(fields: [itemId], references: [id])

  @@map("sales_return_items")
}

model CreditNote {
  id         BigInt   @id @default(autoincrement())
  cnNumber   String   @unique @map("cn_number") @db.VarChar(50)
  returnId   BigInt   @map("return_id")
  customerId Int      @map("customer_id")
  amount     Decimal  @db.Decimal(15, 2)
  usedAmount Decimal  @default(0) @map("used_amount") @db.Decimal(15, 2)
  status     String   @default("open") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  salesReturn SalesReturn @relation(fields: [returnId], references: [id])
  customer    Customer    @relation(fields: [customerId], references: [id])

  @@map("credit_notes")
}

// ============================================================
// PURCHASES
// ============================================================

model PurchaseOrder {
  id          BigInt   @id @default(autoincrement())
  poNumber    String   @unique @map("po_number") @db.VarChar(50)
  supplierId  Int      @map("supplier_id")
  orderDate   DateTime @map("order_date") @db.Date
  expectedDate DateTime? @map("expected_date") @db.Date
  grandTotal  Decimal  @default(0) @map("grand_total") @db.Decimal(15, 2)
  status      String   @default("draft") @db.VarChar(20)
  notes       String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  supplier      Supplier       @relation(fields: [supplierId], references: [id])
  goodsReceipts GoodsReceipt[]

  @@map("purchase_orders")
}

model GoodsReceipt {
  id          BigInt   @id @default(autoincrement())
  grnNumber   String   @unique @map("grn_number") @db.VarChar(50)
  supplierId  Int      @map("supplier_id")
  poId        BigInt?  @map("po_id")
  receiptDate DateTime @map("receipt_date") @db.Date
  warehouseId Int      @map("warehouse_id")
  status      String   @default("completed") @db.VarChar(20)
  notes       String?
  createdBy   Int?     @map("created_by")
  createdAt   DateTime @default(now()) @map("created_at")

  supplier         Supplier             @relation(fields: [supplierId], references: [id])
  purchaseOrder    PurchaseOrder?       @relation(fields: [poId], references: [id])
  warehouse        Warehouse            @relation(fields: [warehouseId], references: [id])
  items            GoodsReceiptItem[]
  purchaseInvoices PurchaseInvoice[]

  @@map("goods_receipts")
}

model GoodsReceiptItem {
  id          BigInt  @id @default(autoincrement())
  grnId       BigInt  @map("grn_id")
  itemId      Int     @map("item_id")
  receivedQty Decimal @map("received_qty") @db.Decimal(12, 4)
  unitCost    Decimal @map("unit_cost") @db.Decimal(15, 4)

  goodsReceipt GoodsReceipt @relation(fields: [grnId], references: [id])

  @@map("goods_receipt_items")
}

model PurchaseInvoice {
  id                 BigInt        @id @default(autoincrement())
  invoiceNumber      String        @unique @map("invoice_number") @db.VarChar(50)
  supplierInvoiceRef String?       @map("supplier_invoice_ref") @db.VarChar(100)
  supplierId         Int           @map("supplier_id")
  grnId              BigInt?       @map("grn_id")
  invoiceDate        DateTime      @map("invoice_date") @db.Date
  dueDate            DateTime?     @map("due_date") @db.Date
  subtotal           Decimal       @db.Decimal(15, 2)
  discountAmount     Decimal       @default(0) @map("discount_amount") @db.Decimal(15, 2)
  taxAmount          Decimal       @default(0) @map("tax_amount") @db.Decimal(15, 2)
  grandTotal         Decimal       @map("grand_total") @db.Decimal(15, 2)
  paidAmount         Decimal       @default(0) @map("paid_amount") @db.Decimal(15, 2)
  outstandingAmount  Decimal       @default(0) @map("outstanding_amount") @db.Decimal(15, 2)
  status             InvoiceStatus @default(confirmed)
  stockPosted        Boolean       @default(false) @map("stock_posted")
  notes              String?
  createdBy          Int?          @map("created_by")
  idempotencyKey     String?       @unique @map("idempotency_key") @db.VarChar(100)
  createdAt          DateTime      @default(now()) @map("created_at")
  updatedAt          DateTime      @updatedAt @map("updated_at")

  supplier           Supplier              @relation(fields: [supplierId], references: [id])
  goodsReceipt       GoodsReceipt?         @relation(fields: [grnId], references: [id])
  createdByUser      User?                 @relation(fields: [createdBy], references: [id])
  items              PurchaseInvoiceItem[]
  purchaseReturns    PurchaseReturn[]
  paymentAllocations PaymentAllocation[]

  @@index([invoiceNumber])
  @@index([invoiceDate])
  @@index([supplierId])
  @@map("purchase_invoices")
}

model PurchaseInvoiceItem {
  id             BigInt   @id @default(autoincrement())
  invoiceId      BigInt   @map("invoice_id")
  itemId         Int      @map("item_id")
  unitId         Int?     @map("unit_id")
  conversionFactor Decimal @default(1) @map("conversion_factor") @db.Decimal(15, 6)
  quantity       Decimal  @db.Decimal(12, 4)
  unitCost       Decimal  @map("unit_cost") @db.Decimal(15, 4)
  discountPct    Decimal  @default(0) @map("discount_pct") @db.Decimal(8, 4)
  discountAmount Decimal  @default(0) @map("discount_amount") @db.Decimal(15, 4)
  taxType        TaxType? @map("tax_type")
  taxRate        Decimal  @default(0) @map("tax_rate") @db.Decimal(8, 4)
  taxRateId      Int?     @map("tax_rate_id")
  taxAmount      Decimal  @default(0) @map("tax_amount") @db.Decimal(15, 4)
  lineTotal      Decimal  @map("line_total") @db.Decimal(15, 4)
  returnedQty    Decimal  @default(0) @map("returned_qty") @db.Decimal(12, 4)

  invoice    PurchaseInvoice @relation(fields: [invoiceId], references: [id])
  item       Item            @relation(fields: [itemId], references: [id])
  unit       Unit?           @relation(fields: [unitId], references: [id])
  taxRateRef TaxRate?        @relation(fields: [taxRateId], references: [id])
  returnItems PurchaseReturnItem[]

  @@index([invoiceId])
  @@map("purchase_invoice_items")
}

model PurchaseReturn {
  id                BigInt   @id @default(autoincrement())
  returnNumber      String   @unique @map("return_number") @db.VarChar(50)
  originalInvoiceId BigInt   @map("original_invoice_id")
  supplierId        Int      @map("supplier_id")
  returnDate        DateTime @map("return_date") @db.Date
  returnReason      String?  @map("return_reason")
  totalAmount       Decimal  @default(0) @map("total_amount") @db.Decimal(15, 2)
  status            String   @default("completed") @db.VarChar(20)
  createdBy         Int?     @map("created_by")
  createdAt         DateTime @default(now()) @map("created_at")

  originalInvoice PurchaseInvoice   @relation(fields: [originalInvoiceId], references: [id])
  supplier        Supplier          @relation(fields: [supplierId], references: [id])
  items           PurchaseReturnItem[]
  debitNotes      DebitNote[]

  @@map("purchase_returns")
}

model PurchaseReturnItem {
  id          BigInt  @id @default(autoincrement())
  returnId    BigInt  @map("return_id")
  originalItemId BigInt @map("original_item_id")
  itemId      Int     @map("item_id")
  returnedQty Decimal @map("returned_qty") @db.Decimal(12, 4)
  unitCost    Decimal @map("unit_cost") @db.Decimal(15, 4)
  lineTotal   Decimal @map("line_total") @db.Decimal(15, 4)

  purchaseReturn PurchaseReturn      @relation(fields: [returnId], references: [id])
  originalItem   PurchaseInvoiceItem @relation(fields: [originalItemId], references: [id])
  item           Item                @relation(fields: [itemId], references: [id])

  @@map("purchase_return_items")
}

model DebitNote {
  id         BigInt   @id @default(autoincrement())
  dnNumber   String   @unique @map("dn_number") @db.VarChar(50)
  returnId   BigInt   @map("return_id")
  supplierId Int      @map("supplier_id")
  amount     Decimal  @db.Decimal(15, 2)
  status     String   @default("open") @db.VarChar(20)
  createdAt  DateTime @default(now()) @map("created_at")

  purchaseReturn PurchaseReturn @relation(fields: [returnId], references: [id])

  @@map("debit_notes")
}

// ============================================================
// PAYMENTS & CASH
// ============================================================

model CashDrawerSession {
  id              BigInt    @id @default(autoincrement())
  sessionNumber   String    @unique @map("session_number") @db.VarChar(50)
  cashierId       Int       @map("cashier_id")
  openingCash     Decimal   @default(0) @map("opening_cash") @db.Decimal(15, 2)
  openingTime     DateTime  @default(now()) @map("opening_time")
  cashSales       Decimal   @default(0) @map("cash_sales") @db.Decimal(15, 2)
  cashCollections Decimal   @default(0) @map("cash_collections") @db.Decimal(15, 2)
  cashRefunds     Decimal   @default(0) @map("cash_refunds") @db.Decimal(15, 2)
  changeGiven     Decimal   @default(0) @map("change_given") @db.Decimal(15, 2)
  cashExpenses    Decimal   @default(0) @map("cash_expenses") @db.Decimal(15, 2)
  expectedClosing Decimal   @default(0) @map("expected_closing") @db.Decimal(15, 2)
  actualClosing   Decimal?  @map("actual_closing") @db.Decimal(15, 2)
  difference      Decimal?  @db.Decimal(15, 2)
  closingTime     DateTime? @map("closing_time")
  status          String    @default("open") @db.VarChar(20)
  notes           String?

  cashier       User           @relation(fields: [cashierId], references: [id])
  salesInvoices SalesInvoice[]
  payments      Payment[]

  @@map("cash_drawer_sessions")
}

model Payment {
  id             BigInt        @id @default(autoincrement())
  paymentNumber  String        @unique @map("payment_number") @db.VarChar(50)
  paymentDate    DateTime      @map("payment_date") @db.Date
  paymentType    String        @map("payment_type") @db.VarChar(20)
  partyType      String?       @map("party_type") @db.VarChar(20)
  customerId     Int?          @map("customer_id")
  supplierId     Int?          @map("supplier_id")
  paymentMethod  PaymentMethod @map("payment_method")
  amount         Decimal       @db.Decimal(15, 2)
  cashTendered   Decimal?      @map("cash_tendered") @db.Decimal(15, 2)
  changeGiven    Decimal       @default(0) @map("change_given") @db.Decimal(15, 2)
  transactionRef String?       @map("transaction_ref") @db.VarChar(255)
  paymentStatus  PaymentStatus @default(completed) @map("payment_status")
  sessionId      BigInt?       @map("session_id")
  narration      String?
  createdBy      Int?          @map("created_by")
  idempotencyKey String?       @unique @map("idempotency_key") @db.VarChar(100)
  createdAt      DateTime      @default(now()) @map("created_at")

  customer   Customer?          @relation(fields: [customerId], references: [id])
  supplier   Supplier?          @relation(fields: [supplierId], references: [id])
  session    CashDrawerSession? @relation(fields: [sessionId], references: [id])
  allocations PaymentAllocation[]

  @@map("payments")
}

model PaymentAllocation {
  id                BigInt  @id @default(autoincrement())
  paymentId         BigInt  @map("payment_id")
  invoiceType       String  @map("invoice_type") @db.VarChar(20)
  salesInvoiceId    BigInt? @map("sales_invoice_id")
  purchaseInvoiceId BigInt? @map("purchase_invoice_id")
  allocatedAmount   Decimal @map("allocated_amount") @db.Decimal(15, 2)
  createdAt         DateTime @default(now()) @map("created_at")

  payment         Payment          @relation(fields: [paymentId], references: [id])
  salesInvoice    SalesInvoice?    @relation(fields: [salesInvoiceId], references: [id])
  purchaseInvoice PurchaseInvoice? @relation(fields: [purchaseInvoiceId], references: [id])

  @@map("payment_allocations")
}

model PaymentGateway {
  id          Int      @id @default(autoincrement())
  code        String   @unique @db.VarChar(50)
  name        String   @db.VarChar(100)
  provider    String?  @db.VarChar(50)
  merchantId  String?  @map("merchant_id") @db.VarChar(255)
  apiEndpoint String?  @map("api_endpoint") @db.VarChar(500)
  isSandbox   Boolean  @default(true) @map("is_sandbox")
  isActive    Boolean  @default(false) @map("is_active")
  configJson  String?  @map("config_json")
  createdAt   DateTime @default(now()) @map("created_at")

  @@map("payment_gateways")
}

// ============================================================
// CHART OF ACCOUNTS & DOUBLE-ENTRY ACCOUNTING
// ============================================================

model Account {
  id             Int         @id @default(autoincrement())
  accountCode    String      @unique @map("account_code") @db.VarChar(20)
  name           String      @db.VarChar(255)
  accountType    AccountType @map("account_type")
  parentId       Int?        @map("parent_id")
  isGroup        Boolean     @default(false) @map("is_group")
  openingBalance Decimal     @default(0) @map("opening_balance") @db.Decimal(15, 2)
  isSystem       Boolean     @default(false) @map("is_system")
  isActive       Boolean     @default(true) @map("is_active")
  createdAt      DateTime    @default(now()) @map("created_at")

  parent   Account?  @relation("AccountParent", fields: [parentId], references: [id])
  children Account[] @relation("AccountParent")
  journalLines JournalEntryLine[]

  @@map("accounts")
}

model FiscalPeriod {
  id        Int      @id @default(autoincrement())
  name      String   @db.VarChar(100)
  startDate DateTime @map("start_date") @db.Date
  endDate   DateTime @map("end_date") @db.Date
  isClosed  Boolean  @default(false) @map("is_closed")
  closedBy  Int?     @map("closed_by")
  closedAt  DateTime? @map("closed_at")

  journalEntries JournalEntry[]

  @@map("fiscal_periods")
}

model JournalEntry {
  id             BigInt        @id @default(autoincrement())
  voucherNumber  String        @unique @map("voucher_number") @db.VarChar(50)
  voucherDate    DateTime      @map("voucher_date") @db.Date
  voucherType    String?       @map("voucher_type") @db.VarChar(50)
  narration      String?
  status         JournalStatus @default(posted)
  referenceType  String?       @map("reference_type") @db.VarChar(50)
  referenceId    BigInt?       @map("reference_id")
  fiscalPeriodId Int?          @map("fiscal_period_id")
  createdBy      Int?          @map("created_by")
  postedBy       Int?          @map("posted_by")
  createdAt      DateTime      @default(now()) @map("created_at")

  fiscalPeriod     FiscalPeriod?     @relation(fields: [fiscalPeriodId], references: [id])
  createdByUser    User?             @relation("CreatedBy", fields: [createdBy], references: [id])
  postedByUser     User?             @relation("PostedBy", fields: [postedBy], references: [id])
  lines            JournalEntryLine[]

  @@index([voucherDate])
  @@index([referenceType, referenceId])
  @@map("journal_entries")
}

model JournalEntryLine {
  id         BigInt  @id @default(autoincrement())
  entryId    BigInt  @map("entry_id")
  accountId  Int     @map("account_id")
  debit      Decimal @default(0) @db.Decimal(15, 2)
  credit     Decimal @default(0) @db.Decimal(15, 2)
  narration  String?
  partyType  String? @map("party_type") @db.VarChar(20)
  customerId Int?    @map("customer_id")
  supplierId Int?    @map("supplier_id")

  entry   JournalEntry @relation(fields: [entryId], references: [id])
  account Account      @relation(fields: [accountId], references: [id])

  @@index([accountId])
  @@index([entryId])
  @@map("journal_entry_lines")
}
